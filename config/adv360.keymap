#define ZMK_POINTING_DEFAULT_MOVE_VAL 1400  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 40    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>

#define STRINGIFY(x) #x
#define EXPAND_AND_STRINGIFY(x) STRINGIFY(x)

#define KEYS_NONE
#define HYPER LS(LC(LA(LGUI)))

#define KEYS_LEFT   0 1 2 3 4 5 6 \
                    14 15 16 17 18 19 20 \
                    28 29 30 31 32 33 34 \
                    46 47 48 49 50 51 \
                    60 61 62 63 64

#define KEYS_RIGHT  7 8 9 10 11 12 13 \
                    21 22 23 24 25 26 27 \
                    39 40 41 42 43 44 45 \
                    54 55 56 57 58 59 \
                    71 72 73 74 75

#define THUMBS_LEFT 35 36 52 65 66 67

#define THUMBS_RIGHT 37 38 53 68 69 70

#define THUMBS THUMBS_LEFT THUMBS_RIGHT

#define MORPH(ID, LOWER, UPPER, MRPH) \
    ID: mod_morph_##ID { \
        compatible = "zmk,behavior-mod-morph"; \
        #binding-cells = <0>; \
        bindings = <&kp LOWER>, <&kp UPPER>; \
        mods = <(MRPH)>; \
    };

#define SUPER(ID, FIRST, SECOND, TERM, QTAP, RPI, KEYS, FLAVE, ...) \
    ID: mod_tap_##ID { \
        compatible = "zmk,behavior-hold-tap"; \
        quick_tap_ms = <QTAP>; \
        tapping-term-ms = <TERM>; \
        flavor = FLAVE; \
        #binding-cells = <2>; \
        bindings = <&FIRST>, <&SECOND>; \
        require-prior-idle-ms = <RPI>; \
        hold-trigger-key-positions = <KEYS>; \
        hold-while-undecided-linger; \
        __VA_ARGS__ \
    };

#define PROFILE(ID, INDEX, LAYER_ON, LAYER_OFF) \
    ID: bt_profile_##ID { \
        compatible = "zmk,behavior-macro"; \
        #binding-cells = <0>; \
        wait-ms = <0>; \
        tap-ms  = <0>; \
        bindings = <&bt BT_SEL INDEX>, <&tog_off LAYER_OFF>, <&tog_on LAYER_ON> ; \
    };


#define L_OS_WIN  1
#define L_OS_MAC  2

&sk {
    quick-release;
    release-after-ms = <500>;
    /delete-property/ ignore-modifiers;
};

&soft_off {
    hold-time-ms = <2000>;
};

&caps_word {
    continue-list = <UNDERSCORE SEMI PIPE AMPS MINUS BACKSPACE DELETE LSHFT RSHFT>;
};

/ {
    behaviors {
        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            display-name = "Toggle Layer On";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            display-name = "Toggle Layer Off";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        SUPER(lcwm, mo, caps_word, 135, 0,   0, KEYS_NONE, "hold-preferred")
        SUPER(lcwp, kp, caps_word, 135, 0,   0, KEYS_NONE, "hold-preferred")

        SUPER(kpp, kp, kp, 135, 165, 25, KEYS_NONE,  "hold-preferred")
        SUPER(lkp, mo, kp, 135, 165, 25, KEYS_NONE,  "tap-preferred")

        SUPER(kpr, kp, kp, 130, 165, 25, KEYS_LEFT,  "balanced")
        SUPER(kpl, kp, kp, 130, 165, 25, KEYS_RIGHT, "balanced")

        MORPH(one,   EXCL,   N1, MOD_LSFT|MOD_RSFT)
        MORPH(two,   AT,     N2, MOD_LSFT|MOD_RSFT)
        MORPH(three, HASH,   N3, MOD_LSFT|MOD_RSFT)
        MORPH(four,  DOLLAR, N4, MOD_LSFT|MOD_RSFT)
        MORPH(five,  PRCNT,  N5, MOD_LSFT|MOD_RSFT)
        MORPH(six,   CARET,  N6, MOD_LSFT|MOD_RSFT)
        MORPH(seven, AMPS,   N7, MOD_LSFT|MOD_RSFT)
        MORPH(eight, ASTRK,  N8, MOD_LSFT|MOD_RSFT)
        MORPH(nine,  LPAR,   N9, MOD_LSFT|MOD_RSFT)
        MORPH(zero,  RPAR,   N0, MOD_LSFT|MOD_RSFT)

        PROFILE(pfl0, 0, L_OS_MAC, L_OS_WIN)
        PROFILE(pfl1, 1, L_OS_MAC, L_OS_WIN)
        PROFILE(pfl2, 2, L_OS_WIN, L_OS_MAC)
        PROFILE(pfl3, 3, L_OS_WIN, L_OS_MAC)
        PROFILE(pfl4, 4, L_OS_WIN, L_OS_MAC)

        #include "macros.dtsi"
        #include "version.dtsi"
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Def-Base";
            bindings = <
                &lkp  4 PSCRN &kp N1     &kp N2    &kp N3    &kp N4     &kp N5    &mo 3                                                                           &mo 4           &kp N6  &kp N7     &kp N8     &kp N9      &kp N0      &lkp 4 BSPC
                &lcwm 5 0     &kp Q      &kp W     &kp E     &kp R      &kp T     &kp RIGHT                                                                       &kp UP          &kp Y   &kp U      &kp I      &kp O       &kp P       &lkp 5 DEL
                &lkp  6 TAB   &kp A      &kp S     &kp D     &kp F      &kp G     &kp LEFT         &kpp LGUI DEL &mo  3      &mo  4       &lcwp RALT 0            &kp DOWN        &kp H   &kp J      &kp K      &kp L       &kp SEMI    &lkp 6 SQT
                &lkp  3 ESC   &kp Z      &kp X     &kp C     &kp V      &kp B                                    &lkp 3 END  &lkp 3 PG_UP                                         &kp N   &kp M      &kp COMMA  &kp DOT     &kp FSLH    &lkp 3 ENTER
                &mo   8       &kp TAB    &kp GRAVE &kp BSLH  &kp EQUAL            &kpl LSHFT BSPC &kpp LCTRL ESC &lkp 6 HOME &lkp 6 PG_DN &kpp RCTRL ENTER &kpr RSHFT SPACE               &kp MINUS  &kp LBKT   &kp RBKT    &kp SQT     &mo 8
            >;
        };
        default_win {
            display-name = "Def-Mac";
            bindings = <
                &trans       &trans  &trans  &trans  &trans   &trans    &trans                                                &trans &trans  &trans  &trans  &trans   &trans    &trans
                &trans       &trans  &trans  &trans  &trans   &trans    &trans                                                &trans &trans  &trans  &trans  &trans   &trans    &trans
                &lkp 6 TAB   &trans  &trans  &trans  &trans   &trans    &trans         &trans &trans &trans &trans            &trans &trans  &trans  &trans  &trans   &trans    &lkp 6 SQT
                &trans       &trans  &trans  &trans  &trans   &trans                          &trans &trans                          &trans  &trans  &trans  &trans   &trans    &trans
                &trans       &trans  &trans  &trans  &trans                &trans &trans &lkp 6 HOME &lkp 6 PG_DN &trans &trans              &trans  &trans  &trans   &trans    &trans
            >;
        };
        default_mac {
            display-name = "Def-Mac";
            bindings = <
                &trans       &trans  &trans  &trans  &trans   &trans    &trans                                                &trans &trans  &trans  &trans  &trans   &trans    &trans
                &trans       &trans  &trans  &trans  &trans   &trans    &trans                                                &trans &trans  &trans  &trans  &trans   &trans    &trans
                &lkp 7 TAB   &trans  &trans  &trans  &trans   &trans    &trans         &trans &trans &trans &trans            &trans &trans  &trans  &trans  &trans   &trans    &lkp 7 SQT
                &trans       &trans  &trans  &trans  &trans   &trans                          &trans &trans                          &trans  &trans  &trans  &trans   &trans    &trans
                &trans       &trans  &trans  &trans  &trans                &trans &trans &lkp 7 HOME &lkp 7 PG_DN &trans &trans              &trans  &trans  &trans   &trans    &trans
            >;
        };
        default_num {
            display-name = "Def-Num";
            bindings = <
                &none  &none  &none          &msc SCRL_UP   &none           &none &none                                                          &none &none &kp KP_NUM     &kp KP_DIVIDE   &kp KP_MULTIPLY &kp KP_EQUAL  &none
                &none  &none  &msc SCRL_LEFT &mmv MOVE_UP   &msc SCRL_RIGHT &none &none                                                          &none &none &kp KP_N7      &kp KP_N8       &kp KP_N9       &kp KP_MINUS  &none
                &none  &none  &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &none             &mkp 3 &none &none &mkp 3                    &none &none &kp KP_N4      &kp KP_N5       &kp KP_N6       &kp KP_PLUS   &none
                &none  &none  &none          &msc SCRL_DOWN &none           &none                          &none &none                                 &none &kp KP_N1      &kp KP_N2       &kp KP_N3       &kp KP_ENTER  &none
                &none  &none  &none          &none          &none                            &mkp 1 &mkp 2 &none &none &mkp 2 &mkp 1                         &kp KP_COMMA   &kp KP_NUMBER_0 &kp KP_DOT      &kp KP_ENTER  &none
            >;
        };
        default_mod {
            display-name = "Def-Mod";
            bindings = <
                &bt BT_CLR  &pfl0        &pfl1        &pfl2        &pfl3        &pfl4        &bl BL_TOG                              &bl BL_TOG &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4 &bt BT_CLR
                &bootloader &none        &none        &none        &none        &none        &bl BL_SET 5                            &bl BL_INC &none         &none         &none         &none         &none         &bootloader
                &sys_reset  &none        &none        &none        &none        &none        &bl BL_CYCLE  &none &none &none &none   &bl BL_DEC &none         &none         &none         &none         &none         &sys_reset
                &none       &none        &none        &none        &none        &none                            &none &none                    &none         &none         &none         &none         &none         &none
                &none       &none        &none        &bl BL_OFF   &bl BL_ON                         &none &none &none &none &none &none                      &bl BL_DEC    &bl BL_INC    &none         &none         &none
            >;
        };
        default_med {
            display-name = "Def-Med";
            bindings = <
                &none &none             &none         &none           &none                 &none                  &none                   &none &none       &none          &none         &none          &none                &none
                &none &kp C_AL_JOURNAL  &kp C_AL_WORD &kp C_AL_EMAIL  &kp C_AL_TEXT_EDITOR  &kp C_AL_TASK_MANAGER  &none                   &none &kp C_RW    &kp C_PAUSE    &kp C_PLAY    &kp C_FF       &kp C_STOP_EJECT     &none
                &none &kp C_AL_CALC &kp C_AL_SHEET &kp C_AL_DOCS &kp C_AL_FILES &kp C_AL_TEXT_EDITOR &bl BL_CYCLE  &none &none &none &none &none &kp C_PREV  &kp C_VOL_DN   &kp C_VOL_UP  &kp C_NEXT     &kp C_MUTE           &none
                &none &kp C_AL_IMAGES   &kp C_AL_CONTROL_PANEL &kp C_AL_CAL &kp C_AL_MUSIC   &kp C_AL_WWW                &none &none             &kp C_REC   &kp C_SHUFFLE  &kp C_REPEAT  &kp C_CAPTIONS &kp C_DATA_ON_SCREEN &none
                &none &kp C_AL_SELECT_TASK &kp C_AL_HELP  &kp C_AL_PREV_TASK &kp C_AL_NEXT_TASK              &none &none &none &none &none &none             &kp C_BRI_DN   &kp C_BRI_UP  &kp C_SNAPSHOT &none                &none
            >;
        };
        win_nav {
            display-name = "Nav-win";
            bindings = <
                &kp F10         &kp F1               &kp F2             &kp F3              &kp F4          &kp F5       &kp C_PP                                 &kp C_MUTE    &kp F6       &kp F7          &kp F8          &kp F9         &kp F10  &kp F12
                &macro_backtick &kp LA(F4)           &Win_Select_Word   &macro_kill_to_end  &kp LC(BSPC)    &kp LC(HOME) &kp C_NEXT                               &kp C_VOL_UP  &kp RC(LEFT) &kp RC(DOWN)    &kp RC(UP)      &kp RC(RIGHT)  &none    &macro_block
                &macro_parens   &macro_kill_to_start &macro_select_line &macro_kill_line    &kp LC(DEL)     &kp LC(A)    &kp C_PREV  &trans &trans &trans &trans  &kp C_VOL_DN  &kp LEFT     &kp DOWN        &kp UP          &kp RIGHT      &none    &macro_braces
                &macro_quotes   &Win_Undo            &Win_Cut           &Win_Copy           &Win_Paste      &kp LC(END)                     &trans &trans                       &kp HOME     &kp PG_DN       &kp PG_UP       &kp END        &none    &macro_dquotes
                &macro_angles   &none                &macro_fatarrow   &macro_join_pln      &macro_join_nln                    &trans &trans &trans &trans &trans &trans                     &macro_open_dln &macro_open_uln &macro_arrow   &none    &macro_brackets
            >;
        };
        mac_nav {
            display-name = "Nav-mac";
            bindings = <
                &kp F10         &kp F1               &kp F2             &kp F3              &kp F4           &kp F5       &kp C_PP                                 &kp C_MUTE    &kp F6       &kp F7          &kp F8          &kp F9         &kp F10  &kp F12
                &macro_backtick &kp LG(Q)            &Mac_Select_Word   &macro_kill_to_end  &kp LC(BSPC)     &kp LG(UP)   &kp C_NEXT                               &kp C_VOL_UP  &kp RA(LEFT) &kp RA(DOWN)    &kp RA(UP)      &kp RA(RIGHT)  &none    &macro_block
                &macro_parens   &macro_kill_to_start &macro_select_line &macro_kill_line    &kp LA(DEL)      &kp LG(A)    &kp C_PREV  &trans &trans &trans &trans  &kp C_VOL_DN  &kp LEFT     &kp DOWN        &kp UP          &kp RIGHT      &none    &macro_braces
                &macro_quotes   &Mac_Undo            &Mac_Cut           &Mac_Copy           &Mac_Paste       &kp LG(DOWN)                     &trans &trans                      &kp RG(LEFT) &kp PG_DN       &kp PG_UP       &kp RG(RIGHT)  &none    &macro_dquotes
                &macro_angles   &none                &macro_fatarrow              &macro_join_pln     &macro_join_nln           &trans &trans &trans &trans &trans &trans       &macro_open_dln &macro_open_uln &macro_arrow  &none    &macro_brackets
            >;
        };
    };
};
